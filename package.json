{
  "name": "drukcare",
  "version": "1.0.0",
  "private": true,
  "description": "Bhutan hospital directory and appointment booking",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "setup": "node scripts/setup-local-database.js",
    "deploy": "npm run db:migrate && npm run db:seed && npm start",
    "reminders": "node src/reminder-worker.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.3",
    "connect-session-sequelize": "^7.1.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.5"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5",
    "tar": "^7.5.22",
    "uuid": "^11.1.1"
  }
}
