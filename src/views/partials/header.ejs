<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Find healthcare facilities and book appointments across Bhutan with DrukCare.">
  <title><%= title %> | DrukCare</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
<nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center" href="/"><span class="brand-mark">+</span>DrukCare</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
        <a class="nav-link" href="/hospitals">Hospitals</a>
        <a class="nav-link" href="/doctors">Doctors</a>
        <% if (currentUser) { %>
          <a class="nav-link" href="<%= currentUser.role === 'admin' ? '/admin' : '/dashboard' %>"><%= currentUser.role === 'admin' ? 'Admin' : 'My appointments' %></a>
          <a class="nav-link" href="/profile">Profile</a>
          <form method="post" action="/logout" class="d-inline">
            <button class="btn btn-outline-primary btn-sm ms-lg-2" type="submit">Log out</button>
          </form>
        <% } else { %>
          <a class="nav-link" href="/login">Log in</a>
          <a class="btn btn-primary btn-sm ms-lg-2" href="/register">Create account</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
<main>
  <div class="container pt-3">
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
        <%= flash.text %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
  </div>
