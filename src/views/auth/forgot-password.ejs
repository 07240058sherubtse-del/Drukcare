<%- include('../partials/header', { title: 'Forgot password' }) %>
<div class="container auth-shell"><div class="surface-card p-4 p-md-5">
  <h1 class="h3">Reset your password</h1><p class="text-secondary">Enter the email address linked to your account.</p>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <form method="post" action="/forgot-password"><label class="form-label" for="email">Email</label><input class="form-control mb-3" id="email" name="email" type="email" required><button class="btn btn-primary" type="submit">Send reset link</button></form>
</div></div>
<%- include('../partials/footer') %>
