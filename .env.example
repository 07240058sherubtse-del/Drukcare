NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/drukcare
# Set to true when DATABASE_URL uses a managed TLS PostgreSQL service.
DATABASE_SSL=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SMTP is optional in local development (verification/reset links are logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DrukCare <no-reply@example.com>
ENABLE_REMINDERS=false
